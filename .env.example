# TAKA OS — Development Environment Example
# Copy to .env and customize

# Required
SECRET_KEY=change-me-dev-secret-key-min-32-chars

# Database (override for local dev with Docker on non-default port)
DATABASE_URL=postgresql+asyncpg://takaos:takaos_password_123@localhost:5433/takaos

# Redis
REDIS_URL=redis://localhost:6380/0

# Optional — only if using external services
MISTRAL_API_KEY=
SENTRY_DSN=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
